<Window x:Class="PhasmoHunt.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:PhasmoHunt.Converters"
        Title="Phasmo Hunt"
        Width="520"
        Height="820"
        MinWidth="400"
        MinHeight="640"
        Topmost="True"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        ShowInTaskbar="True">
    <Window.Resources>
        <converters:ScaleTransformConverter x:Key="ScaleConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            LayoutTransform="{Binding UiScale, Converter={StaticResource ScaleConverter}}">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <Grid Grid.Row="0" Margin="0,0,0,8" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Phasmo Hunt" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="⚙"
                        ToolTip="Configurações"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Padding="10,6"
                        Command="{Binding ToggleSettingsCommand}" />
                <Button Grid.Column="2"
                        Content="✕"
                        Style="{StaticResource DangerButton}"
                        Margin="0"
                        Padding="10,6"
                        Click="CloseButton_OnClick" />
            </Grid>

            <!-- Métricas compactas -->
            <Border Grid.Row="1"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Média geral" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding SpeedText}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,6,0">
                        <TextBlock Text="Confiança" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding ConfidenceText}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,6,0">
                        <TextBlock Text="P1" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding Part1Text}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,6,0">
                        <TextBlock Text="P2" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding Part2Text}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="P3" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding Part3Text}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status + ações -->
            <DockPanel Grid.Row="2" Margin="0,0,0,8" LastChildFill="False">
                <WrapPanel DockPanel.Dock="Right">
                    <Button Content="Passo"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,6,0"
                            Padding="10,6"
                            Command="{Binding RecordStepCommand}" />
                    <Button Content="Evidências"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,6,0"
                            Padding="10,6"
                            Command="{Binding ToggleEvidencePanelCommand}" />
                    <Button Content="Limpar"
                            Style="{StaticResource DangerButton}"
                            Margin="0"
                            Padding="10,6"
                            Command="{Binding ClearCommand}" />
                </WrapPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock FontSize="11" Margin="0,2,0,0">
                        <Run Text="{Binding StepCountText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                        <Run Text="  ·  " Foreground="{StaticResource MutedBrush}" />
                        <Run Text="{Binding ElapsedText, Mode=OneWay}" />
                        <Run Text="  ·  " Foreground="{StaticResource MutedBrush}" />
                        <Run Text="{Binding StepHotkeyLabel, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="11" Margin="0,2,0,0" Foreground="{StaticResource MutedBrush}"
                               Text="{Binding SelectedEvidenceSummary}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <!-- Painel de evidências -->
            <Border Grid.Row="3"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,0,0,8"
                    Visibility="{Binding IsEvidencePanelOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Evidências encontradas" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Content="Limpar evidências"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0"
                                Padding="8,4"
                                FontSize="11"
                                Command="{Binding ClearEvidenceCommand}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding EvidenceOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayName}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Margin="0,0,12,8"
                                          Foreground="{StaticResource TextBrush}"
                                          FontSize="12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap"
                               Text="Filtra fantasmas junto com a velocidade. Mimic inclui Orb falsa." />
                </StackPanel>
            </Border>

            <!-- Fantasmas: área principal -->
            <Border Grid.Row="4"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="8"
                    Padding="8"
                    Margin="0,0,0,8">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Fantasmas" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="verde apto · vermelho fora"
                                   Style="{StaticResource MutedText}"
                                   FontSize="11"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Ghosts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4,2" Margin="1">
                                        <TextBlock FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Name, Mode=OneWay}"
                                                 FontWeight="SemiBold"
                                                 Foreground="{Binding StatusBrush}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding SpeedRangeText, Mode=OneWay}"
                                                 Foreground="{Binding StatusBrush}"
                                                 FontSize="10" />
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Comparação da sessão + leituras -->
            <Grid Grid.Row="5" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="8"
                        Padding="8"
                        MaxHeight="140">
                    <StackPanel>
                        <TextBlock Text="Comparação da sessão" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding SessionSummaryText}" TextWrapping="Wrap" FontSize="11" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap">
                            <Run Text="P1/P2/P3: " />
                            <Run Text="{Binding SessionSpeedsText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap">
                            <Run Text="Consenso: " FontWeight="SemiBold" />
                            <Run Text="{Binding SessionGhostsText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="8"
                        Padding="8"
                        MaxHeight="140">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="Leituras" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right"
                                    Content="Limpar"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0"
                                    Padding="8,3"
                                    FontSize="11"
                                    HorizontalAlignment="Right"
                                    Command="{Binding ClearHistoryCommand}" />
                        </DockPanel>
                        <ListBox ItemsSource="{Binding History}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 FontSize="11">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2" TextWrapping="Wrap">
                                        <Run Text="{Binding HeaderText, Mode=OneWay}" FontWeight="SemiBold" />
                                        <LineBreak />
                                        <Run Text="P " Foreground="{StaticResource MutedBrush}" />
                                        <Run Text="{Binding PartsText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Row="6"
                    Margin="0,8,0,0"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="8"
                    Padding="12"
                    Visibility="{Binding IsSettingsExpanded, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Configurações" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="Transparência" Style="{StaticResource MutedText}" />
                    <Slider Minimum="0.3" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                            Value="{Binding Opacity, Mode=TwoWay}" Margin="0,4,0,10" />
                    <TextBlock Text="Escala da interface" Style="{StaticResource MutedText}" />
                    <Slider Minimum="0.8" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True"
                            Value="{Binding UiScale, Mode=TwoWay}" Margin="0,4,0,4" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

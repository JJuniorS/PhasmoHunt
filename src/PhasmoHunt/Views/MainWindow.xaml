<Window x:Class="PhasmoHunt.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:PhasmoHunt.Converters"
        Title="Phasmo Hunt"
        Icon="pack://application:,,,/Assets/app-icon.png"
        Width="520"
        Height="820"
        MinWidth="400"
        MinHeight="640"
        Topmost="True"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        ShowInTaskbar="True">
    <Window.Resources>
        <converters:ScaleTransformConverter x:Key="ScaleConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            TextElement.Foreground="{StaticResource TextBrush}"
            LayoutTransform="{Binding UiScale, Converter={StaticResource ScaleConverter}}">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="GhostsRow" Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <Grid Grid.Row="0" Margin="0,0,0,8" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Phasmo Hunt" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="⚙"
                        ToolTip="{Binding Loc.Settings}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Padding="10,6"
                        Click="SettingsButton_OnClick" />
                <Button Grid.Column="2"
                        Content="{Binding CompactToggleGlyph}"
                        ToolTip="{Binding Loc.CompactToggle}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Padding="10,6"
                        Command="{Binding ToggleCompactCommand}" />
                <Button Grid.Column="3"
                        Content="✕"
                        Style="{StaticResource DangerButton}"
                        Margin="0"
                        Padding="10,6"
                        Click="CloseButton_OnClick" />
            </Grid>

            <!-- Métricas compactas -->
            <Border Grid.Row="1"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="{Binding Loc.AverageOverall}" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding SpeedText}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,6,0">
                        <TextBlock Text="{Binding Loc.Confidence}" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding ConfidenceText}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,6,0">
                        <TextBlock Text="P1" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding Part1Text}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,6,0">
                        <TextBlock Text="P2" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding Part2Text}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="P3" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding Part3Text}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status + ações -->
            <DockPanel Grid.Row="2" Margin="0,0,0,8" LastChildFill="False"
                       Visibility="{Binding IsUiCompact, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                <WrapPanel DockPanel.Dock="Right">
                    <Button Content="{Binding Loc.Step}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,6,0"
                            Padding="10,6"
                            Command="{Binding RecordStepCommand}" />
                    <Button Content="{Binding Loc.Evidences}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,6,0"
                            Padding="10,6"
                            Command="{Binding ToggleEvidencePanelCommand}" />
                    <Button Content="{Binding Loc.Clear}"
                            Style="{StaticResource DangerButton}"
                            Margin="0"
                            Padding="10,6"
                            ToolTip="{Binding Loc.ClearHotkeyHint}"
                            Command="{Binding ClearCommand}" />
                </WrapPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock FontSize="11">
                        <Run Text="{Binding StepCountText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                        <Run Text="  ·  " Foreground="{StaticResource MutedBrush}" />
                        <Run Text="{Binding ElapsedText, Mode=OneWay}" />
                        <Run Text="  ·  " Foreground="{StaticResource MutedBrush}" />
                        <Run Text="{Binding StepHotkeyLabel, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="11" Margin="0,2,0,0" Foreground="{StaticResource MutedBrush}"
                               Text="—"
                               Visibility="{Binding HasSelectedEvidence, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <ItemsControl ItemsSource="{Binding EvidenceOptions}" Margin="0,2,0,0"
                                  Visibility="{Binding HasSelectedEvidence, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Icon}"
                                       Width="16"
                                       Height="16"
                                       Margin="0,0,4,0"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                       ToolTip="{Binding DisplayName}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>

            <!-- Painel de evidências -->
            <Border Grid.Row="3"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,0,0,8"
                    Visibility="{Binding ShowEvidencePanel, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding Loc.EvidencesFound}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding EvidenceOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource EvidenceToggle}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              ToolTip="{Binding DisplayName}">
                                    <Image Source="{Binding Icon}"
                                           Width="22"
                                           Height="22"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap"
                               Text="{Binding Loc.EvidencesHint}" />
                </StackPanel>
            </Border>

            <!-- Fantasmas: área principal -->
            <Border Grid.Row="4"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="8"
                    Padding="8"
                    Margin="0,0,0,8"
                    Visibility="{Binding IsUiCompact, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="{Binding Loc.Ghosts}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <CheckBox DockPanel.Dock="Right"
                                  IsChecked="{Binding HideIneligibleGhosts, Mode=TwoWay}"
                                  ToolTip="{Binding Loc.HideIneligibleHint}"
                                  VerticalAlignment="Center"
                                  Margin="8,0,0,0" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <!-- Vertical scroll Auto: conteúdo mede altura natural.
                             Com Disabled, o UniformGrid esticava as linhas com poucos fantasmas. -->
                        <ItemsControl ItemsSource="{Binding Ghosts}"
                                      VerticalAlignment="Top">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" VerticalAlignment="Top" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4,3" Margin="1" VerticalAlignment="Top">
                                        <StackPanel>
                                            <Button Command="{Binding ToggleEligibilityCommand}"
                                                    Cursor="Hand"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Left"
                                                    ToolTip="{Binding DataContext.Loc.GhostToggleTip, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <TextBlock FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Name, Mode=OneWay}"
                                                         FontWeight="SemiBold"
                                                         Foreground="{Binding StatusBrush}" />
                                                    <Run Text=" " />
                                                    <Run Text="{Binding SpeedRangeText, Mode=OneWay}"
                                                         Foreground="{Binding StatusBrush}"
                                                         FontSize="10" />
                                                </TextBlock>
                                            </Button>
                                            <ItemsControl ItemsSource="{Binding EvidenceIcons}" Margin="0,2,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Image Source="{Binding}"
                                                               Width="18"
                                                               Height="18"
                                                               Margin="0,0,3,0"
                                                               Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Peculiaridades + leituras -->
            <Grid Grid.Row="5" Margin="0,0,0,0"
                  Visibility="{Binding IsUiCompact, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="8"
                        Padding="8"
                        MaxHeight="180">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc.Peculiarities}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
                        <WrapPanel>
                            <Border HorizontalAlignment="Left" Margin="0,0,8,8">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource PeculiarityChip}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDemonCooldownSelected}" Value="True">
                                                <Setter Property="Background" Value="#1E3A5F" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDemonCooldownRunning}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{Binding DemonIcon}"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,8,0"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding DemonCooldownText}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border HorizontalAlignment="Left" Margin="0,0,8,8">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource PeculiarityChip}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsIncenseRunning}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{Binding IncenseIcon}"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,8,0"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding IncenseTimerText}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border HorizontalAlignment="Left" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource PeculiarityChip}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsObamboRunning}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{Binding ObamboIcon}"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,8,0"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding ObamboTimerText}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="8"
                        Padding="8"
                        MaxHeight="140">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Loc.Readings}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        </DockPanel>
                        <ListBox ItemsSource="{Binding History}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 FontSize="11">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2" TextWrapping="Wrap">
                                        <Run Text="{Binding HeaderText, Mode=OneWay}" FontWeight="SemiBold" />
                                        <LineBreak />
                                        <Run Text="P " Foreground="{StaticResource MutedBrush}" />
                                        <Run Text="{Binding PartsText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <TextBlock Grid.Row="6"
                       Text="{Binding Loc.FanDisclaimer}"
                       Style="{StaticResource MutedText}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,8,0,0" />
        </Grid>
    </Border>
</Window>

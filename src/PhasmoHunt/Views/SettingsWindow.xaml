<Window x:Class="PhasmoHunt.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:PhasmoHunt.Converters"
        Title="{Binding Loc.Settings}"
        Icon="pack://application:,,,/Assets/app-icon.png"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        ShowInTaskbar="False"
        Opacity="1"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        Closed="Window_OnClosed">
    <Window.Resources>
        <converters:ScaleTransformConverter x:Key="ScaleConverter" />
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            TextElement.Foreground="{StaticResource TextBrush}"
            LayoutTransform="{Binding UiScale, Converter={StaticResource ScaleConverter}}">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,12"
                  MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Loc.Settings}"
                           Style="{StaticResource TitleText}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="✕"
                        Style="{StaticResource DangerButton}"
                        Padding="10,6"
                        Click="CloseButton_OnClick" />
            </Grid>

            <StackPanel Grid.Row="1">
                <TextBlock Text="{Binding Loc.LanguageLabel}" Style="{StaticResource MutedText}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
                    <ToggleButton Content="🇧🇷"
                                  Style="{StaticResource LanguageFlagButton}"
                                  IsChecked="{Binding IsLanguagePtBr, Mode=OneWay}"
                                  ToolTip="Português (Brasil)"
                                  Click="PtBrFlag_OnClick" />
                    <ToggleButton Content="EN"
                                  Style="{StaticResource LanguageFlagButton}"
                                  FontSize="14"
                                  IsChecked="{Binding IsLanguageEn, Mode=OneWay}"
                                  ToolTip="English"
                                  Click="EnFlag_OnClick" />
                </StackPanel>

                <TextBlock Text="{Binding Loc.Opacity}" Style="{StaticResource MutedText}" />
                <Slider Minimum="0.3"
                        Maximum="1.0"
                        TickFrequency="0.05"
                        IsSnapToTickEnabled="True"
                        Value="{Binding Opacity, Mode=TwoWay}"
                        Margin="0,4,0,12" />
                <TextBlock Text="{Binding Loc.UiScale}" Style="{StaticResource MutedText}" />
                <Slider Minimum="0.8"
                        Maximum="1.5"
                        TickFrequency="0.05"
                        IsSnapToTickEnabled="True"
                        Value="{Binding UiScale, Mode=TwoWay}"
                        Margin="0,4,0,12" />

                <TextBlock Text="{Binding Loc.GhostSpeedPercent}" Style="{StaticResource MutedText}" />
                <TextBox Text="{Binding GhostSpeedPercentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,12" />

                <TextBlock Text="{Binding Loc.Hotkeys}" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding Loc.ClearHotkeyHint}"
                           Style="{StaticResource MutedText}"
                           FontSize="11"
                           Margin="0,0,0,8" />

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Loc.Step}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding StepHotkeyText, Mode=OneWay}"
                             IsReadOnly="True"
                             Focusable="True"
                             Tag="StepHotkeyText"
                             PreviewMouseLeftButtonDown="HotkeyBox_OnPreviewMouseLeftButtonDown" />
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Loc.Demon}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding DemonHotkeyText, Mode=OneWay}"
                             IsReadOnly="True"
                             Focusable="True"
                             Tag="DemonHotkeyText"
                             PreviewMouseLeftButtonDown="HotkeyBox_OnPreviewMouseLeftButtonDown" />
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Loc.Incense}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding IncenseHotkeyText, Mode=OneWay}"
                             IsReadOnly="True"
                             Focusable="True"
                             Tag="IncenseHotkeyText"
                             PreviewMouseLeftButtonDown="HotkeyBox_OnPreviewMouseLeftButtonDown" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Loc.Obambo}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding ObamboHotkeyText, Mode=OneWay}"
                             IsReadOnly="True"
                             Focusable="True"
                             Tag="ObamboHotkeyText"
                             PreviewMouseLeftButtonDown="HotkeyBox_OnPreviewMouseLeftButtonDown" />
                </Grid>

                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="#E35D6A"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <Button Content="{Binding Loc.Save}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        Click="SaveButton_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
